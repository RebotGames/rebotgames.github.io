---
const steamUrl = 'https://store.steampowered.com/app/4516640/Megabait/';
---
<section class="game" id="megabait">
  <h2>Megabait</h2>
  <img
    class="capsule"
    src="/images/capsule_horizontal.jpg"
    alt="Megabait"
    width="616"
    height="353"
    loading="lazy"
  />
  <video
    class="roster-clip"
    poster="/images/megabait-roster-idle.jpg"
    width="662"
    height="308"
    autoplay
    loop
    muted
    playsinline
    aria-label="The Megabait characters in their idle poses"
  >
    <source src="/videos/megabait-roster-idle.webm" type="video/webm" />
    <source src="/videos/megabait-roster-idle.mp4" type="video/mp4" />
  </video>
  <p>
    A brutal top-down obstacle course where every second counts. Master
    precise movement to survive deadly hazard rooms, leave a bloody trail of
    your past mistakes, and uncover every secret on your path to 100%
    completion.
  </p>
  <div class="links">
    <a class="store-link" href={steamUrl} target="_blank" rel="noopener">Wishlist on Steam</a>
  </div>
  <video
    class="gameplay-clip"
    poster="/images/megabait-character-abilities.jpg"
    width="1170"
    height="658"
    autoplay
    loop
    muted
    playsinline
    aria-label="Each character has a unique ability that changes how a level is played"
  >
    <source src="/videos/megabait-character-abilities.webm" type="video/webm" />
    <source src="/videos/megabait-character-abilities.mp4" type="video/mp4" />
  </video>
</section>

<script>
  // Press emails link here carrying utm_* params. Forward them onto the Steam
  // link so a visit that arrives through the site is still attributed to the
  // outlet in Steamworks. utm_medium is overridden to "website" so this path
  // stays distinguishable from the Steam link clicked directly in the email.
  const inbound = new URLSearchParams(window.location.search);

  if (inbound.has('utm_source')) {
    const forwarded = new URLSearchParams();

    for (const key of ['utm_source', 'utm_campaign', 'utm_content', 'utm_term']) {
      const value = inbound.get(key);
      if (value) forwarded.set(key, value);
    }
    forwarded.set('utm_medium', 'website');

    const storeLinks = document.querySelectorAll<HTMLAnchorElement>(
      'a[href*="store.steampowered.com"]',
    );

    for (const link of storeLinks) {
      const url = new URL(link.href);
      for (const [key, value] of forwarded) url.searchParams.set(key, value);
      link.href = url.toString();
    }
  }
</script>

<style>
  .game {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 3rem;
    text-align: center;
  }
  h2 {
    margin-bottom: 1rem;
  }
  .capsule {
    width: 100%;
    max-width: 460px;
    height: auto;
    border-radius: 8px;
    margin-bottom: 1.25rem;
  }
  p {
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
  .roster-clip {
    width: 100%;
    max-width: 460px;
    height: auto;
    margin-bottom: 1.25rem;
  }
  .gameplay-clip {
    width: 100%;
    max-width: 460px;
    height: auto;
    border-radius: 8px;
  }
  .links {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .store-link {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    font-size: 0.95rem;
    color: var(--color-accent);
  }
  .store-link:hover {
    border-color: var(--color-accent);
  }
</style>
